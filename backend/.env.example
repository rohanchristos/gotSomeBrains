# Backend Environment Variables
# Copy this file to .env and fill in your values

PORT=3001
# MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mental_health_app?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mental_health_app?retryWrites=true&w=majority
NODE_ENV=development
