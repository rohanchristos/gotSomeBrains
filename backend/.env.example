# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Configuration
# For local development: mongodb://localhost:27017/mental_health_app
# For production: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mental_health_app?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/mental_health_app

# CORS Configuration
# For development: http://localhost:5173
# For production: https://your-frontend-domain.com (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173

# Rate Limiting (optional, defaults provided)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
